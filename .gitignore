__pycache__/
*.pyc
.env
.venv/
.pytest_cache/
.DS_Store

# Scratch output of the most recent run. Superseded on every invocation, so
# committing it produces noise rather than a record.
eval/last_run.json
eval/last_proof_run.json

# eval/results/ is DELIBERATELY tracked. scripts/run_experiments.py files each
# run into a timestamped folder with its logs, artefacts and a manifest of the
# model, package versions and git commit. That is the durable experimental
# record and it belongs in history.

# PutnamBench-derived goal files may embed MAA-permissioned informal text
# (informal/putnam.json). Never committed -- see eval/putnam.py.
eval/putnam*.json

# The PutnamBench clone itself. `informal/putnam.json` in it is the text the
# maintainers describe as available with permission from the MAA, so this must
# never enter history -- `eval/putnam.py` reads it from a local checkout for
# exactly that reason. The RESULTS of running it are fine and are tracked:
# verified, they carry only formal Lean statements, proofs and telemetry, with
# no `goal` field and no informal prose.
PutnamBench/

# Stale duplicate snapshots of the whole tree, ~840K, and a live hazard: a
# grep for anything in this repo matches twice and the second hit is old code.
claude-context/
claude-context-2.zip

# A local dump of `git log`, regenerated on demand and already in the history
# it describes.
GIT_HISTORY.txt

# A workspace left in the repo root. Anything that calls a Lean seam with
# workdir "." creates it -- a diagnostic script, a probe, a one-off check --
# and it is a scratch proof log, never evidence. The evidence that matters
# lives in eval/evidence/, copied there deliberately.
/math/

# Scratch workdirs from scripts/replay_sources.py. It recompiles sources that
# results files already hold, so these are ~105 near-empty proof_logs with no
# records in them -- regenerable for free and noise in history. The RESULTS
# they were derived from are tracked, which is the durable part.
eval/replay/

# The scratch file `git commit -F` reads. Superseded on every commit.
commit_msg.txt

# Written by scripts/mutate_guard.py while a mutation is on disk, so a run
# killed mid-mutation can put the file back on the next start. Never committed:
# its presence means the tree is currently broken on purpose.
.mutate_guard_pending.json
